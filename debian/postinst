#!/bin/sh
set -e

PI_HOME="/opt/pi-console"
DATA_DIR="/var/lib/pi-console"
AUTH_LINK="/opt/pi-console-auth"

echo "pi-console: configurando instalacion..."

# ── 1. Crear usuario del sistema ──────────────────────────────────────────────
if ! id -u pi-console >/dev/null 2>&1; then
    useradd --system --no-create-home --shell /usr/sbin/nologin pi-console
    echo "  usuario pi-console creado"
fi

# ── 2. Directorio de datos persistentes (nunca tocado por dpkg) ───────────────
mkdir -p "$DATA_DIR"
chown pi-console:pi-console "$DATA_DIR"
chmod 750 "$DATA_DIR"

# ── 2b. Teleporter: directorio de trabajo + regla sudo para el panel de admin ─
# El panel (usuario pi-console) solo puede ejecutar estas dos acciones como root.
install -d -m 700 -o pi-console -g pi-console "$DATA_DIR/teleporter"
if [ -d /etc/sudoers.d ] && command -v visudo >/dev/null 2>&1; then
    SUDOERS_TMP=$(mktemp)
    cat > "$SUDOERS_TMP" <<'SUDOEOF'
# Pi Console: el panel de admin ejecuta el respaldo/restauracion como root
pi-console ALL=(root) NOPASSWD: /usr/local/bin/teleporter.sh gui-backup, /usr/local/bin/teleporter.sh gui-restore *
SUDOEOF
    if visudo -cf "$SUDOERS_TMP" >/dev/null 2>&1; then
        install -m 0440 -o root -g root "$SUDOERS_TMP" /etc/sudoers.d/pi-console-teleporter
        echo "  regla sudo para teleporter instalada"
    else
        echo "  AVISO: regla sudo invalida, respaldo desde el panel deshabilitado"
    fi
    rm -f "$SUDOERS_TMP"
else
    echo "  AVISO: sudo no esta instalado; el respaldo desde el panel queda deshabilitado (usa 'teleporter' en consola)"
fi

# ── 3. Symlink auth compartido → datos persistentes ───────────────────────────
mkdir -p "$AUTH_LINK"
ln -sf "$PI_HOME/auth/auth.py"        "$AUTH_LINK/auth.py"        2>/dev/null || true
ln -sf "$DATA_DIR/users.json"         "$AUTH_LINK/users.json"     2>/dev/null || true
ln -sf "$DATA_DIR/sessions.json"      "$AUTH_LINK/sessions.json"  2>/dev/null || true
chown -h pi-console:pi-console "$AUTH_LINK"/* 2>/dev/null || true
chown pi-console:pi-console "$AUTH_LINK"

# ── 4. Permisos de directorios de código ─────────────────────────────────────
chown -R pi-console:pi-console "$PI_HOME"
chmod 755 "$PI_HOME"
for module in wol-console nut-monitor net-monitor proxmox-monitor auth; do
    chown pi-console:pi-console "$PI_HOME/$module"
    chmod 755 "$PI_HOME/$module"
done

# ttyUSB0 para NUT (UPS por serial)
if getent group dialout >/dev/null 2>&1; then
    usermod -aG dialout pi-console 2>/dev/null || true
fi

# ── 5. Instalar archivos de servicio systemd ──────────────────────────────────
install_service() {
    name="$1" desc="$2" module="$3" script="$4"
    cat > "/etc/systemd/system/${name}.service" <<EOF
[Unit]
Description=Pi Console — ${desc}
After=network.target
Wants=network.target

[Service]
Type=simple
User=pi-console
WorkingDirectory=${PI_HOME}/${module}
ExecStart=/usr/bin/python3 ${PI_HOME}/${module}/${script}
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=${name}

[Install]
WantedBy=multi-user.target
EOF
    echo "  servicio ${name} instalado"
}

install_service "wol-console"     "WOL Console"     "wol-console"     "server.py"
install_service "nut-monitor"     "NUT Monitor"      "nut-monitor"     "server.py"
install_service "admin-panel"     "Admin Panel"      "auth"            "admin_panel.py"
install_service "net-monitor"     "Net Monitor"      "net-monitor"     "server.py"
install_service "proxmox-monitor" "Proxmox Monitor"  "proxmox-monitor" "server.py"

# ── 6. Nginx ──────────────────────────────────────────────────────────────────
if [ -f /etc/nginx/sites-enabled/default ]; then
    rm -f /etc/nginx/sites-enabled/default
fi
ln -sf /etc/nginx/sites-available/pi-console.conf \
       /etc/nginx/sites-enabled/pi-console.conf 2>/dev/null || true

# ── 7. Migrar datos desde rutas antiguas (solo una vez) ──────────────────────
# Si los datos estaban en la ruta antigua /opt/pi-console/auth/ o en backup,
# los movemos a /var/lib/pi-console/ — solo si aún no existen ahí.
BACKUP_DIR="/var/backups/pi-console"

if [ ! -f "$DATA_DIR/users.json" ]; then
    # Intentar migrar desde backup (upgrade desde versión anterior)
    latest_users=$(ls -t "$BACKUP_DIR/users.json".*.bak 2>/dev/null | head -1)
    if [ -n "$latest_users" ]; then
        cp "$latest_users" "$DATA_DIR/users.json"
        chown pi-console:pi-console "$DATA_DIR/users.json"
        chmod 600 "$DATA_DIR/users.json"
        echo "  usuarios migrados desde backup: $latest_users"
    else
        # Fresh install: crear admin/admin
        python3 -c "
import hashlib, json, time
salt = 'pi-console-salt-change-me'
pw   = hashlib.sha256(f'{salt}:admin'.encode()).hexdigest()
users = {'admin': {'password_hash': pw, 'permissions': {
    'wol':'admin','nut':'admin','net':'admin','pve':'admin'
}, 'created': int(time.time()), 'must_change_password': True}}
print(json.dumps(users, indent=2))
" > "$DATA_DIR/users.json"
        chown pi-console:pi-console "$DATA_DIR/users.json"
        chmod 600 "$DATA_DIR/users.json"
        echo "  users.json creado (admin / admin)"
    fi
else
    echo "  usuarios existentes conservados en $DATA_DIR"
fi

# Migrar sessions.json si existe en backup y no hay uno nuevo
if [ ! -f "$DATA_DIR/sessions.json" ]; then
    latest_sess=$(ls -t "$BACKUP_DIR/sessions.json".*.bak 2>/dev/null | head -1)
    if [ -n "$latest_sess" ]; then
        cp "$latest_sess" "$DATA_DIR/sessions.json"
        chown pi-console:pi-console "$DATA_DIR/sessions.json"
    else
        echo "{}" > "$DATA_DIR/sessions.json"
        chown pi-console:pi-console "$DATA_DIR/sessions.json"
    fi
fi

# ── 7b. Restaurar datos de los módulos desde backup (solo si faltan) ──────────
# Dispositivos WOL, servidores UPS, historial, hosts, config y clusters viven
# dentro de /opt/pi-console. Si no existen (reinstalación tras remove/purge),
# se recuperan del backup. Nunca se sobrescribe un archivo existente.
# history.db: se usa el respaldo MÁS GRANDE (el más reciente puede ser una base
# casi vacía creada por un reinicio previo); el resto, el más reciente.
if [ -d "$BACKUP_DIR" ]; then
    MODULE_FILES="
wol-console/devices.json:devices.json
nut-monitor/servers.json:servers.json
nut-monitor/history.db:history.db
net-monitor/hosts.json:hosts.json
net-monitor/config.json:config.json
proxmox-monitor/clusters.json:clusters.json
"
    printf '%s\n' "$MODULE_FILES" | grep -v '^$' | while IFS=: read -r rel_path base; do
        dest="$PI_HOME/$rel_path"
        [ -f "$dest" ] && continue
        if [ "$base" = "history.db" ]; then
            src=$(ls -S "$BACKUP_DIR/${base}".*.bak 2>/dev/null | head -1)
        else
            src=$(ls -t "$BACKUP_DIR/${base}".*.bak 2>/dev/null | head -1)
        fi
        if [ -n "$src" ]; then
            mkdir -p "$(dirname "$dest")"
            cp "$src" "$dest"
            chown pi-console:pi-console "$dest"
            echo "  restaurado: $rel_path (desde $src)"
        fi
    done
fi

# ── 8. Recargar y habilitar servicios ─────────────────────────────────────────
systemctl daemon-reload

for svc in wol-console nut-monitor admin-panel net-monitor proxmox-monitor; do
    systemctl enable "$svc" 2>/dev/null || true
    systemctl restart "$svc" 2>/dev/null || true
    echo "  $svc habilitado"
done

if nginx -t -q 2>/dev/null; then
    systemctl enable nginx 2>/dev/null || true
    systemctl reload nginx 2>/dev/null || systemctl restart nginx 2>/dev/null || true
    echo "  nginx recargado"
else
    echo "  AVISO: nginx -t fallo, verificar configuracion manualmente"
fi

echo ""
echo "╔════════════════════════════════════════════════╗"
echo "║  Pi Console instalado correctamente            ║"
echo "║  URL: http://$(hostname -I | awk '{print $1}')                  ║"
echo "║  Usuario inicial: admin / admin                ║"
echo "║  (cambiar contrasena en el primer login)       ║"
echo "╚════════════════════════════════════════════════╝"
